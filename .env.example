# Keep real secrets in Vercel Project Settings > Environment Variables.
# Never commit a populated .env file.
ITFM_AI_API_KEY=
# Base URL for an OpenAI Chat Completions-compatible provider, e.g. provider's /v1 base (do not include /chat/completions unless intended).
ITFM_AI_BASE_URL=
ITFM_AI_MODEL=
TMDB_API_KEY=
# Optional custom M3U playlist; defaults to public IPTV-org playlist.
IPTV_M3U_URL=
# Required for user sign-in and ITFM AI key management. Never expose service role key in browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
